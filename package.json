{
  "name": "@floez-werk/piagent-private-ai",
  "version": "0.1.2",
  "description": "Pi extension: use private-ai (privatemode.ai) models as a provider",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "license": "MIT",
  "author": "FloezWerk",
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloezWerk/piagent-private-ai.git"
  },
  "homepage": "https://github.com/FloezWerk/piagent-private-ai#readme",
  "bugs": {
    "url": "https://github.com/FloezWerk/piagent-private-ai/issues"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "readme": "npx -y @floez-werk/pi-extension-release-tool@^0.1 sync-readme",
    "release-notes": "npx -y @floez-werk/pi-extension-release-tool@^0.1 release-notes",
    "check": "npm run check:readme && npm run check:bundle && npm run check:pack",
    "check:readme": "npx -y @floez-werk/pi-extension-release-tool@^0.1 sync-readme --check",
    "check:bundle": "npx -y esbuild@0.25.12 extensions/piagent-private-ai.ts --bundle --format=esm --platform=node --external:@earendil-works/* --outfile=/tmp/piagent-private-ai.mjs",
    "check:pack": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}